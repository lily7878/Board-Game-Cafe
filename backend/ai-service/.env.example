# Copy to .env only for running the service by hand; scripts/start-ai.ps1 sets these for you.
# Never commit real values.

# Shared secret with Core (generated by scripts/start-backend.ps1 / start-ai.ps1).
BGC_AI_INTERNAL_TOKEN=

# Ollama (free, local). Any OpenAI-compatible server works by changing these four values.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=bge-m3
LLM_TIMEOUT_SECONDS=30
